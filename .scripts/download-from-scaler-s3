#!/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat << 'EOF'
Download from Scaler S3 - Batch download files from S3

USAGE:
    download-from-scaler-s3 [-t] [filename]

OPTIONS:
    -t              Use timestamps for downloaded filenames
    -h, --help      Show this help message

ARGUMENTS:
    filename        File containing S3 paths (default: s3-links)

DESCRIPTION:
    Downloads multiple files from S3 based on paths listed in the input file.
    Shows a progress bar during download. Skips files that already exist.
    Uses the 'prod-dev' AWS profile.

EXAMPLES:
    download-from-scaler-s3
    download-from-scaler-s3 -t my-s3-paths
    download-from-scaler-s3 custom-links
EOF
    exit 0
fi

# Default filename
default_filename="s3-links"
filename=${1:-$default_filename}

# Check for '-t' and '-p' flags
use_timestamp=false

while getopts "th" opt; do
  case $opt in
    t)
      use_timestamp=true
      ;;
    h)
      cat << 'EOF'
Download from Scaler S3 - Batch download files from S3

USAGE:
    download-from-scaler-s3 [-t] [filename]

OPTIONS:
    -t              Use timestamps for downloaded filenames
    -h, --help      Show this help message

ARGUMENTS:
    filename        File containing S3 paths (default: s3-links)

DESCRIPTION:
    Downloads multiple files from S3 based on paths listed in the input file.
    Shows a progress bar during download. Skips files that already exist.
    Uses the 'prod-dev' AWS profile.

EXAMPLES:
    download-from-scaler-s3
    download-from-scaler-s3 -t my-s3-paths
    download-from-scaler-s3 custom-links
EOF
      exit 0
      ;;
    *)
      ;;
  esac
done

shift $((OPTIND -1))
filename=${1:-$default_filename}

s3_paths=($(cat $filename))

# Total number of files
total_files=${#s3_paths[@]}
completed_files=0
skipped_files=0

# Function to update progress bar
update_progress() {
  progress=$(( ($completed_files * 100) / $total_files ))
  echo -ne "Downloading: ["
  for ((i=0; i<$progress; i+=2)); do echo -ne "#"; done
  for ((i=$progress; i<100; i+=2)); do echo -ne " "; done
  echo -ne "] $progress% ($completed_files/$total_files) [skipped_files: $skipped_files/$completed_files]\r"
}

# Function to download a single file
download_file() {
  local s3_path=$1
  original_file_name=$(echo $s3_path | awk -F '/' '{print $9}')
  if [ "$use_timestamp" = true ]; then
    file_name=$(date +%Y%m%d%H%M%S)
  else
    file_name=$original_file_name
  fi

  if [ -f "$file_name" ]; then
    skipped_files=$((skipped_files + 1))
  else
    aws --profile prod-dev s3 cp "$s3_path" "$file_name" > /dev/null 2>&1
  fi
  completed_files=$((completed_files + 1))
  update_progress
  sleep 1 # To ensure unique timestamps
}

# Download files sequentially
echo "Starting downloads..."
for s3_path in "${s3_paths[@]}"; do
  download_file "$s3_path"
done

echo -ne "\nDownload complete.\n"


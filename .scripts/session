#!/bin/bash

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat << 'EOF'
Session - tmux session manager

USAGE:
    session [directory]

ARGUMENTS:
    directory       Directory to create session for
                    If not provided, uses fzf to select from predefined paths

DESCRIPTION:
    Simple tmux session manager. Lists existing tmux sessions and directories
    from predefined paths (mind-palace, work-station). Creates new sessions
    or switches to existing ones.

    Search paths:
    - ~/mind-palace
    - ~/work-station/bench/work
    - ~/work-station/bench/personal
    - ~/work-station/dump/
    - ~/work-station/dump/personal

EXAMPLES:
    session
    session ~/my-project
EOF
    exit 0
fi

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Get list of current tmux sessions
    current_sessions=$(tmux list-sessions -F "#S" 2>/dev/null)
    # Find directories and prepend current sessions to the list
    selected=$( (echo "$current_sessions"; echo "------------"; find ~/mind-palace ~/work-station/bench/work ~/work-station/bench/personal ~/work-station/dump/ ~/work-station/dump/personal -mindepth 1 -maxdepth 1 -type d) | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Check if the selected item is a tmux session
if echo "$current_sessions" | grep -q "^$selected$"; then
    tmux switch-client -t $selected
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name

